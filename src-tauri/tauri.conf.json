{
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devPath": "http://localhost:1420",
        "distDir": "../dist"
    },
    "package": {
        "productName": "HyClyint Beta",
        "version": "0.1.7"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "window": {
                "all": true
            },
            "shell": {
                "all": false,
                "open": true
            }
        },
        "windows": [
            {
                "title": "HyClyint Beta",
                "width": 1280,
                "height": 720,
                "minWidth": 960,
                "minHeight": 600,
                "decorations": false
            }
        ],
        "updater": {
            "active": true,
            "dialog": true,
            "endpoints": [
                "https://github.com/HyClyint/Launcher/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4Mjc2OTg3QUMwNzc3NjEKUldSaGR3ZXNoMmtudU05MStBYmNtNTF0SDZORVdjSzFJU0xWOTNSRWViRkY1OVpHQytoTEtBUWQK",
            "windows": {
                "installMode": "passive"
            }
        },
        "security": {
            "csp": null
        },
        "bundle": {
            "active": true,
            "targets": "all",
            "identifier": "com.trifleslabs.hyclyint.launcher",
            "icon": ["icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
        }
    }
}
