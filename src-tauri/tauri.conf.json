{
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devPath": "http://localhost:1420",
        "distDir": "../dist"
    },
    "package": {
        "productName": "HyClyint Beta",
        "version": "0.1.1"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "window": {
                "all": true
            },
            "shell": {
                "all": false,
                "open": true
            }
        },
        "windows": [
            {
                "title": "HyClyint Beta",
                "width": 1280,
                "height": 720,
                "minWidth": 960,
                "minHeight": 600,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        },
        "bundle": {
            "active": true,
            "targets": "all",
            "identifier": "com.trifleslabs.hyclyint.launcher",
            "icon": ["icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
        }
    }
}
